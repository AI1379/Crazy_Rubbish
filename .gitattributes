* text=auto eol=lf
*.cs text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.unity text eol=lf whitespace=-blank-at-eol
*.prefab text eol=lf whitespace=-blank-at-eol
*.asset text eol=lf whitespace=-blank-at-eol
*.meta text eol=lf whitespace=-blank-at-eol
*.mat text eol=lf whitespace=-blank-at-eol

# Preserve the supplied original document snapshots byte-for-byte.
/Docs/Source/*.md -text
/Docs/Source/S6_20261013/** -text
/Assets/_Game/Art/Fonts/OFL.txt -text whitespace=-blank-at-eol

# Binary art, models, audio, video, and fonts use Git LFS.
*.png filter=lfs diff=lfs merge=lfs -text
